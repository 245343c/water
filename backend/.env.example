PORT=3000
MONGO_URI=mongodb://localhost:27017/sri_sai_ro_water
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Logging
LOG_LEVEL=info

# CORS — comma-separated origins in production (e.g. https://app.example.com)
# CORS_ORIGINS=https://app.example.com

# Rate limiting (per IP, 15 min window)
RATE_LIMIT_MAX=500
OTP_RATE_LIMIT_MAX=20

# MongoDB connection pool (production tuning)
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5

# Dev-only demo OTP for customer login (omit in production)
CUSTOMER_DEMO_OTP=123456

# Public base URL for uploaded images (production)
# PUBLIC_BASE_URL=https://api.example.com
