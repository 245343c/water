PORT=3000
MONGO_URI=mongodb://localhost:27017/sri_sai_ro_water
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ─── Environment mode ───────────────────────────────────────────────────────────
# local       → disk uploads, OTP shown in API (dev only)
# production  → GCP uploads + SMS OTP (never expose OTP in JSON)
APP_ENV=local
NODE_ENV=development

# Storage: local (disk) | gcp (Google Cloud Storage)
STORAGE_MODE=local
PUBLIC_BASE_URL=http://localhost:3000

# GCP (required when STORAGE_MODE=gcp in production)
# GCS_BUCKET=your-bucket-name
# GCP_PROJECT_ID=your-gcp-project

# OTP: local (dev demo) | sms (production — Twilio or MSG91)
OTP_MODE=local
CUSTOMER_DEMO_OTP=123456

# SMS — Twilio (production)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# SMS — MSG91 (alternative)
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=SRSAI
# MSG91_OTP_TEMPLATE_ID=

# Logging
LOG_LEVEL=info

# CORS — comma-separated origins in production
# CORS_ORIGINS=https://app.example.com

# Rate limiting (per IP, 15 min window)
RATE_LIMIT_MAX=500
OTP_RATE_LIMIT_MAX=20

# MongoDB connection pool
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5

# Flutter: flutter run --dart-define=API_BASE_URL=http://YOUR_PC_IP:3000/api
